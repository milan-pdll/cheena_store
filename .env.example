# Root environment example for local orchestration (Database-Free)
ENVIRONMENT=development

# Catalog Storage Mode: "local" (uses JSON file) or "cloudinary" (raw asset in cloud)
CATALOG_STORE=local
CATALOG_FILE_PATH=./data/catalog.json
CATALOG_BACKUP_DIR=./data/backups
CATALOG_MAX_BACKUPS=10

# Security (JWT)
SECRET_KEY=change_this_to_a_super_secret_key_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Single Admin Account (configured via environment)
ADMIN_EMAIL=admin@footballstore.com
ADMIN_PASSWORD_HASH=$2b$12$e6xU7O2B5O7Wl2rSvyFz4eKqvM1hF4yQ0N8sE4uP4nZ5h6g7j8k9l

# Cloudinary Configuration (Used for raw catalog storage in production and product images)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=sample_secret_key
CLOUDINARY_RAW_CATALOG_ID=catalog/catalog.json

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WHATSAPP_FALLBACK_NUMBER=1234567890
